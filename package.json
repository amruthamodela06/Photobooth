{
    "name": "flashpoint-desktop",
    "version": "1.0.0",
    "description": "Professional-grade Photo Booth application",
    "main": "main.js",
    "scripts": {
        "start": "concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:5173 && electron .\"",
        "server": "nodemon server/index.js",
        "client": "npm run dev --prefix client",
        "build": "npm run build --prefix client",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "keywords": [
        "photobooth",
        "electron",
        "react",
        "node",
        "express"
    ],
    "author": "Antigravity",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "mongoose": "^8.0.0",
        "sharp": "^0.33.0",
        "winston": "^3.11.0"
    },

    "devDependencies": {
        "concurrently": "^8.2.2",
        "electron": "^40.1.0",
        "electron-builder": "^26.7.0",
        "nodemon": "^3.0.1",
        "wait-on": "^7.2.0"
    }
}