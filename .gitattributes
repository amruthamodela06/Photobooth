# Normalize line endings: store LF in the repo, check out native endings
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
